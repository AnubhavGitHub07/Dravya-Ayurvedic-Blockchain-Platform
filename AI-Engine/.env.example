# ==============================================================================
# Dravya AI Engine — Production & Local Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local configuration overrides.
# NEVER commit `.env` or real credentials/secrets to version control.
# ==============================================================================

# Server Network Configuration (Cloud platforms inject $PORT automatically)
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
# Set DRAVYA_FRONTEND_ORIGIN to your deployed frontend URL (e.g. https://dravya-ayurveda.vercel.app)
# Additional comma-separated origins can be supplied via DRAVYA_CORS_ORIGINS
DRAVYA_FRONTEND_ORIGIN=
DRAVYA_CORS_ORIGINS=

# Application & Model Directory Paths (relative to AI-Engine/ or absolute)
DRAVYA_CONFIG_PATH=configs/config.yaml
DRAVYA_MODELS_DIR=models
DRAVYA_DATASET_ROOT=datasets/raw
DRAVYA_REPORTS_DIR=reports/dataset_analysis
DRAVYA_EVALUATION_REPORTS_DIR=reports/model_evaluation

# Dravya AI Assistant LLM Provider Configuration
# Supported providers: mock (deterministic offline engine - default) | openai | generic_http
DRAVYA_LLM_PROVIDER=mock
DRAVYA_LLM_API_KEY=
DRAVYA_LLM_MODEL=gpt-4o-mini
